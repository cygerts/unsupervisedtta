#!/bin/bash -l

#SBATCH --job-name=sar_corr_all
#SBATCH --gpus=1
#SBATCH --time=48:00:00
#SBATCH --account=plgttaautopilot-gpu-a100
#SBATCH --partition=plgrid-gpu-a100
#SBATCH --cpus-per-task=8
#SBATCH --mem=8G
#SBATCH --gres=gpu
#SBATCH -e slurm/slurm.%N.%j.err # STDERR
#SBATCH -o slurm/slurm.%N.%j.out # STDOUT

module load Miniconda3/4.9.2
conda activate /net/people/plgrid/plgseb/storage/venv/tta

method=sar       # choose from: source, norm_test, tent, eata, sar, cotta, rotta, adacontrast, lame, gtta, rmt,  roid
setting=correlated # choose from: continual, mixed_domains, correlated, mixed_domains_correlated
seeds=(3)         # to reproduce the benchmark results, use: (1 2 3 4 5)
options=()        # for RMT source-free without warm-up use: options=("RMT.LAMBDA_CE_SRC 0.0 RMT.NUM_SAMPLES_WARM_UP 0")

cifar10=("cfgs/cifar10_c/${method}.yaml")
cifar100=("cfgs/cifar100_c/${method}.yaml")
imagenet_c=("cfgs/imagenet_c/${method}.yaml")
imagenet_r=("cfgs/imagenet_others/${method}.yaml")
domain=("cfgs/domainnet126/${method}.yaml")

lrs=(0.001 0.00025 0.0000625 0.0000156)
momentums=(0.9 0.0)
resets=(0.2)
dirichs=(10. 1.0 0.1 0.01)
e0s=(0.4)
step=1
eresets=(0.01 0.05 0.5)
ee0s=(0.1 0.8)

# ---continual---
if [[ $setting = "correlated" ]]
then
  for var in "${cifar100[@]}"; do
    for seed in ${seeds[*]}; do
      seedbash=23*$seed
      for dirich in ${dirichs[*]}; do
        for mom in ${momentums[*]}; do
          for lr in ${lrs[*]}; do
            for rst in ${resets[*]}; do
              for e0 in ${e0s[*]}; do
                if (( $(echo "$mom > 0.0" | bc -l) )); then
                  nest=True
                else
                  nest=False
                fi
                erst="${eresets[RANDOM=$seedbash % ${#eresets[@]}]}"
                seedbash+=1
                ee0="${ee0s[RANDOM=$seedbash % ${#ee0s[@]}]}"
                seedbash+=1
                python test_time.py --cfg $var SETTING $setting RNG_SEED $seed $options OPTIM.LR $lr OPTIM.MOMENTUM $mom OPTIM.NESTEROV $nest SAR.RESET_CONSTANT_EM $rst SAR.E0_MULT $e0 OPTIM.STEPS $step TEST.ALPHA_DIRICHLET $dirich 
                python test_time.py --cfg $var SETTING $setting RNG_SEED $seed $options OPTIM.LR $lr OPTIM.MOMENTUM $mom OPTIM.NESTEROV $nest SAR.RESET_CONSTANT_EM $erst SAR.E0_MULT $ee0 OPTIM.STEPS $step TEST.ALPHA_DIRICHLET $dirich
              done
	          done
          done
        done
      done
    done
  done
fi
